N = length(ET_exp);
dia = (1:N)';
// ========================================================
// Matriz do modelo: a0 + soma[ak*cos(k*w*d)+bk*sin(k*w*d)]
// ========================================================
theta = 2*%pi*(dia-1)/N;
X = ones(N, 2*k+1);
for i = 1:k
    X(:,2*i) = cos(i*theta);
    X(:,2*i+1) = sin(i*theta);
end

// =========================================
// MÉTODO DOS MÍNIMOS QUADRADOS
// ==========================================
coef = inv(X'*X)*(X'*ET_exp);
ET_cal = X*coef;
res = ET_exp - ET_cal;
SSE = sum(res.^2);
SST = sum((ET_exp - mean(ET_exp)).^2);
r = correl(ET_exp, ET_cal);
R2 = r^2;
RMSE = sqrt(mean(res.^2));
erro_max = max(abs(res));
