mprintf("a%d = %.10f; b%d = %.10f\n",i,coef(2*i),i,coef(2*i+1));
end
mprintf("R2 = %.10f\n",R2);
mprintf("RMSE = %.8f min\n",RMSE);
mprintf("Erro maximo absoluto = %.8f min\n",erro_max);

